[Unit]
Description=Publish Codex final-response usage artifacts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/daniele/projects/codex-usage-monitor
ExecStart=/usr/bin/python3 /home/daniele/projects/codex-usage-monitor/codex_usage_publisher.py run
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/daniele/.local/state/codex-usage-publisher /home/daniele/projects/codex-usage /home/daniele/projects /home/daniele/.local/share/codex-usage-monitor
StandardOutput=journal
StandardError=journal
