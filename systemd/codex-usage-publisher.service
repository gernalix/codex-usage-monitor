[Unit]
Description=Publish Codex usage, chat dumps, and GitHub Actions incident state
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/daniele/.local/lib/codex-usage-monitor/current
ExecStart=/usr/bin/python3 /home/daniele/.local/lib/codex-usage-monitor/current/codex_usage_publisher.py run
ExecStart=/usr/bin/python3 /home/daniele/.local/lib/codex-usage-monitor/current/codex_chat_dump_publisher.py run
ExecStart=/usr/bin/python3 /home/daniele/.local/lib/codex-usage-monitor/current/github_actions_watch.py run
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/daniele/.local/state/codex-usage-publisher /home/daniele/projects/codex-usage /home/daniele/projects /home/daniele/.local/share/codex-usage-monitor
StandardOutput=journal
StandardError=journal
