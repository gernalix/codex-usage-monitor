[Unit]
Description=Codex usage monitor SQLite snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/daniele/projects/codex-usage-monitor
Environment=PYTHONUNBUFFERED=1
Environment=CODEX_USAGE_DB=/home/daniele/.local/share/codex-usage-monitor/codex_usage_monitor.db
Environment=CODEX_USAGE_STATE_DIR=/home/daniele/.local/state/codex-usage-monitor
EnvironmentFile=-/home/daniele/.config/codex-usage-monitor/codex-usage-monitor.env
ExecStart=/usr/bin/python3 /home/daniele/projects/codex-usage-monitor/codex_usage_monitor.py once
# Push heartbeats run only after a successful acquisition. Delivery is best-effort:
# a Kuma outage must not turn a successful quota collection into a failed systemd unit.
ExecStartPost=/usr/bin/python3 /home/daniele/projects/codex-usage-monitor/uptime_kuma_push.py --message "codex-usage-monitor cycle ok"
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/daniele/.local/share/codex-usage-monitor /home/daniele/.local/state/codex-usage-monitor /home/daniele/.config/codex-usage-monitor
StandardOutput=journal
StandardError=journal
