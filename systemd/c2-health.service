[Unit]
Description=Aggregate C2 control-plane health
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/daniele/.local/lib/codex-usage-monitor/current
Environment=PYTHONUNBUFFERED=1
LoadCredential=c2-kuma.env:/home/daniele/.config/codex-usage-monitor/c2-kuma.env
ExecStart=/usr/bin/python3 /home/daniele/.local/lib/codex-usage-monitor/current/c2_health.py once
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
