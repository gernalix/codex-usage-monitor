[Unit]
Description=Aggregate C2 control-plane health
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/daniele/.local/lib/codex-usage-monitor/current
Environment=PYTHONUNBUFFERED=1
LoadCredential=uptime-kuma.toml:/home/daniele/.config/codex/secrets/fedora_system_monitor_uptime_kuma.toml
ExecStart=/usr/bin/python3 /home/daniele/.local/lib/codex-usage-monitor/current/c2_health.py once
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
